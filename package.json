{
  "name": "giannis-builds-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "A remote MCP server on Cloudflare Workers: four read-only tools that do real work, plus an MCP Apps result view. Works in Claude, ChatGPT, Grok and any MCP client.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test test/tools.test.mjs test/handler.test.mjs test/view.test.mjs",
    "test:live": "node --test test/live.test.mjs",
    "deploy": "wrangler deploy",
    "check:view": "node test/view.check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "agents": "^0.34.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "wrangler": "^4.165.0"
  }
}
